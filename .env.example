PORT=3002
ADMIN_EMAIL=workshop@autocarx.local
ADMIN_PASSWORD=change-this-password
# DATA_DIR=/absolute/path/to/persistent/data
# Set only when the app runs behind a trusted proxy that overwrites X-Forwarded-For.
# TRUST_PROXY=true

# Optional browser configuration. Without these values, the AI widget is not bundled.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# The Edge Function is disabled by default. Configure these as Supabase secrets,
# never as VITE_ variables or in this file:
# AI_CHAT_ENABLED=true
# ALLOWED_ORIGINS=https://autocarx.netlify.app,http://localhost:8080
# LOVABLE_API_KEY=<server-side secret>
